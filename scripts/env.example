# =============================================================
# 环境变量配置示例文件
# 复制此文件为 env.local 并填写实际值
# 注意：env.local 已加入 .gitignore，不会提交到代码仓库
# =============================================================

# ============================================================
# Kubernetes 配置
# ============================================================
export KUBECONFIG="${HOME}/.kube/config"
export CLUSTER_NAME="cicd-cluster"
export AWS_REGION="us-east-1"

# ============================================================
# Jenkins 配置
# ============================================================
export JENKINS_ADMIN_PASSWORD="your_secure_password_here"
export JENKINS_DEV_PASSWORD="dev_password_here"
export JENKINS_URL="http://jenkins.your-company.com"

# ============================================================
# Harbor 镜像仓库
# ============================================================
export HARBOR_URL="harbor.your-company.com"
export HARBOR_USERNAME="admin"
export HARBOR_PASSWORD="harbor_password_here"

# ============================================================
# GitLab 配置
# ============================================================
export GITLAB_URL="https://gitlab.your-company.com"
export GITLAB_TOKEN="glpat-xxxxxxxxxxxxxxxxxxxx"
export GITLAB_SSH_PRIVATE_KEY="$(cat ~/.ssh/gitlab_id_rsa)"

# ============================================================
# SonarQube 配置
# ============================================================
export SONARQUBE_URL="https://sonarqube.your-company.com"
export SONARQUBE_TOKEN="sqp_xxxxxxxxxxxxxxxxxxxx"

# ============================================================
# 通知配置（可选）
# ============================================================
export SMTP_HOST="smtp.your-company.com"
export SMTP_USERNAME="cicd@your-company.com"
export SMTP_PASSWORD="smtp_password_here"

export DINGTALK_WEBHOOK_URL="https://oapi.dingtalk.com/robot/send?access_token=xxx"
export WECHAT_WEBHOOK_URL="https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx"
